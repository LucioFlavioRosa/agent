# Variáveis de ambiente para configuração do serviço de resolução de grupos via MongoDB
MONGODB_CONNECTION_STRING_SECRET_NAME=mongodb-connection-string-grupo-peers
MONGODB_DATABASE_NAME=nome_do_banco
MONGODB_COLLECTION_NAME=nome_da_collection_mapeamento_grupos

# URLs dos cofres Azure Key Vault segregados por contexto
AZURE_KEY_VAULT_AZURE_INFRASTRUCTURE_URL=https://kv-codeai-azure-dev-usc.vault.azure.net/
AZURE_KEY_VAULT_GITHUB_URL=https://kv-codeai-github-dev-usc.vault.azure.net/
AZURE_KEY_VAULT_AZURE_DEVOPS_URL=https://kv-codeai-devops-dev-usc.vault.azure.net/
AZURE_KEY_VAULT_LLM_URL=https://kv-codeai-llm-dev-usc.vault.azure.net/
