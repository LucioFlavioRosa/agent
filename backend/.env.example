# Exemplo de configuração de variáveis de ambiente para o backend

# JWT
JWT_SECRET_KEY=changeme-supersecret
JWT_ALGORITHM=HS256

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=arquivos

# Azure Active Directory (para validação de token e logging)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret

# Endpoints MCP (JSON string para múltiplos MCPs)
# Exemplo: '{"criacao_epicos_azure_devops": "https://mcp-app-service.azurewebsites.net", "outro_tipo_analise": "https://outro-mcp-app-service.azurewebsites.net"}'
MCP_ENDPOINTS={"criacao_epicos_azure_devops": "https://mcp-app-service.azurewebsites.net"}
